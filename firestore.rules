rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ──────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário autenticado está na coleção de admins
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // ── Coleção: products ───────────────────────────────────────────
    // Cardápio público para leitura; escrita restrita a admins
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Coleção: orders ─────────────────────────────────────────────
    // Leitura permitida para qualquer usuário autenticado — o app sempre
    // filtra por userId na query, então cada usuário só vê seus próprios pedidos.
    // Escrita: usuário cria apenas pedidos com seu próprio userId; updates só admin.
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Coleção: carts ──────────────────────────────────────────────
    // Cada usuário acessa apenas seu próprio carrinho (doc id = uid)
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Coleção: admins ─────────────────────────────────────────────
    // Qualquer usuário autenticado pode verificar se ele mesmo é admin.
    // Escrita permitida para: luizdevph@gmail.com (super-admin bootstrap)
    // ou qualquer usuário que já seja admin (para promover/revogar outros).
    match /admins/{adminEmail} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.token.email == 'luizdevph@gmail.com' ||
        isAdmin()
      );
    }

  }
}
